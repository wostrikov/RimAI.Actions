<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.7 and nothing older. 1.7 is not a Unity player: it runs on
    .NET 10, its assemblies sit in the game folder itself, and one assembly -
    UnityStubs - stands in for everything that was UnityEngine.*Module.dll.
    So this is net10.0 and compiles against that stand-in, which turns a
    Unity member 1.7 does not have into a compile error here instead of a
    type that fails to load there. The 1.6 build is the tag
    rimworld-1.6-final.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The game loads a mod assembly from the mod's own folder: no deps
         file beside it. A package this mod ships has to reach the output. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>RimAI.Actions</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>12.0</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Actions\bin\Release\</OutputPath>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
    <RimWorldWorkshopDir Condition="'$(RimWorldWorkshopDir)' == ''">$(RIMWORLD_WORKSHOP_DIR)</RimWorldWorkshopDir>
    <ReconstructionReferenceDir Condition="'$(ReconstructionReferenceDir)' == ''">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Actions\reconstruction-refs</ReconstructionReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="CapabilityRuntime\**" />
    <Compile Remove="CapabilityRuntime.Tests\**" />
    <Compile Remove="Integrations\**" />
    <Compile Remove="Core\**" />
    <Compile Remove="XXX\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The mod ships two assemblies. Nothing here references the second one,
         so it is built for its side of the package rather than for the compiler. -->
    <ProjectReference Include="CapabilityRuntime\RimAI.Actions.CapabilityRuntime.csproj" ReferenceOutputAssembly="false" />
    <!-- Each sibling ships in its own mod, so compile against them without
         copying their output here. -->
    <ProjectReference Include="..\..\RimAI.Core\src\RimAI.Core\RimAI.Core.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\RimAI.Core\src\RimAI.RimWorld\RimAI.RimWorld.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\RimAI.Communication\Source\RimAI.Communication.csproj">
      <Private>false</Private>
    </ProjectReference>
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs"><HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldDir)\Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony" HintPath="$(RimWorldDir)\Mods\Harmony\1.7\Assemblies\0Harmony.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ReconstructionReferenceDir)\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
</Project>

